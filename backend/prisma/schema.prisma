generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  fullName     String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Destination {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  tagline      String
  description  String
  // JSON-encoded array of required documents
  documents    String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id              Int         @id @default(autoincrement())
  fullName        String
  email           String
  citizenship     String
  status          String      @default("pending")
  /** JSON blob with questionnaire answers (trip, documents, extras) */
  details         String      @default("{}")
  createdAt       DateTime    @default(now())
  destination     Destination @relation(fields: [destinationCode], references: [code])
  destinationCode String
  user            User?       @relation(fields: [userId], references: [id])
  userId          Int?
}
