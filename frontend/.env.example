# Optional. Defaults to `/api` (Vite proxies this to the backend in development).
# For a live API, set an absolute origin, e.g. https://api.example.com/api
# VITE_API_BASE_URL=/api

# Browser-only mode (no backend/SQLite). Auth and applications use localStorage.
# Production builds without VITE_API_BASE_URL enable this automatically (GitHub Pages).
# VITE_USE_LOCAL_DATA=true

# Used only by Vite when building for GitHub Pages.
# BASE_PATH=/visa_project/

# Backend origin that Vite proxies `/api` to in `npm run dev`.
# API_PROXY_TARGET=http://localhost:3001
